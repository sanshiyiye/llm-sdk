# =========================================================================
# ⚠️ 注意：以下被注释掉的变量是 LiteLLM Proxy 服务端需要的，业务侧 SDK 不会读取！
# 请将它们配置在【启动 LiteLLM Proxy 的终端环境变量】或 Kubernetes Secret 中。
# 
# Windows PowerShell 示例:
# $env:LITELLM_MASTER_KEY="sk-123456"
# $env:OPENAI_API_KEY="sk-..."
# =========================================================================

# # LiteLLM Proxy 服务端鉴权主密钥（自己设置）
# LITELLM_MASTER_KEY=sk-123456
# # OpenAI API Key
# OPENAI_API_KEY=
# # Anthropic API Key
# ANTHROPIC_API_KEY=
# # Gemini API Key
# GEMINI_API_KEY=
# # SiliconFlow API Key
# SILICONFLOW_API_KEY=
# # PostgreSQL 审计日志
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/litellm
# # Langfuse 可观测性
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# =========================================================================
# 下面的变量才是业务代码（Python/TypeScript/Go SDK）真正会读取的配置
# =========================================================================

# LiteLLM Proxy 服务的访问地址
LLM_BASE_URL=http://localhost:4000

# 访问 Proxy 服务的鉴权密钥（必须与服务端启动时设置的 LITELLM_MASTER_KEY 保持一致）
LLM_API_KEY=sk-123456

# ── 覆盖能力标签对应的具体模型（可选，不填则使用 SDK 默认值）──
LLM_MODEL_CHAT=
LLM_MODEL_VISION=
LLM_MODEL_VIDEO=
LLM_MODEL_EMBEDDING=
LLM_MODEL_IMAGE_GEN=
LLM_MODEL_FAST=
LLM_MODEL_REASONING=
LLM_MODEL_LOCAL=
