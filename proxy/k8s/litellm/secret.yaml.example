# secret.yaml.example — 提交 git（模板）
# 真实 secret 用 kubectl create secret 创建，不提交 git
apiVersion: v1
kind: Secret
metadata:
  name: litellm-secrets
  namespace: llm-system
type: Opaque
stringData:
  ANTHROPIC_API_KEY: ""
  OPENAI_API_KEY: ""
  GEMINI_API_KEY: ""
  SILICONFLOW_API_KEY: ""
  LITELLM_MASTER_KEY: ""
  DATABASE_URL: "postgresql://postgres:postgres@postgres-rw.llm-system.svc.cluster.local:5432/litellm"
  LANGFUSE_HOST: "https://cloud.langfuse.com"
  LANGFUSE_PUBLIC_KEY: ""
  LANGFUSE_SECRET_KEY: ""
