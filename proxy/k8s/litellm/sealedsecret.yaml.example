apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: litellm-secrets
  namespace: llm-system
spec:
  encryptedData:
    ANTHROPIC_API_KEY: ""
    OPENAI_API_KEY: ""
    GEMINI_API_KEY: ""
    SILICONFLOW_API_KEY: ""
    LITELLM_MASTER_KEY: ""
    DATABASE_URL: ""
    LANGFUSE_HOST: ""
    LANGFUSE_PUBLIC_KEY: ""
    LANGFUSE_SECRET_KEY: ""
  template:
    metadata:
      name: litellm-secrets
      namespace: llm-system
    type: Opaque
